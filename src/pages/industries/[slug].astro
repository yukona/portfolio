---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries.map((industry) => ({
    params: { slug: industry.id },
    props: { industry },
  }));
}

const { industry } = Astro.props;
const {
  name,
  pageTitle,
  headline,
  description,
  metaDescription,
  heroImage,
  keyChallenges,
  whyMe,
  ctaHeadline,
  ctaSubhead,
  clientSlugs,
} = industry.data;

// Resolve client slugs to client data
const allClients = await getCollection('clients');
const clientMap = Object.fromEntries(allClients.map((c) => [c.id, c.data]));
const relatedClients = (clientSlugs ?? [])
  .map((slug) => ({ slug, data: clientMap[slug] }))
  .filter((c) => c.data);
---

<BaseLayout
  title={pageTitle ?? `${name} — Kris Burger`}
  description={metaDescription ?? description}
>

  <!-- ── Header ─────────────────────────────────────────────────────────── -->
  <header class="industry-header" style={heroImage ? `background-image: url(${heroImage})` : ''}>
    <div class="container">
      <div class="header-inner" data-reveal>
        <span class="header-eyebrow section-label">Industry</span>
        <h1 class="header-name">{headline ?? name}</h1>
        {headline && <p class="header-name-sub">{name}</p>}
        <p class="header-description">{description}</p>
      </div>
    </div>
  </header>

  <!-- ── Key Challenges ─────────────────────────────────────────────────── -->
  {keyChallenges && keyChallenges.length > 0 && (
    <section class="section section--surface" data-reveal>
      <div class="container">
        <span class="section-label">Key challenges</span>
        <div class="challenges-grid">
          {keyChallenges.map((challenge) => (
            <div class="challenge-card" data-reveal-child>
              <span class="challenge-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </span>
              <p class="challenge-text">{challenge}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Why Me ──────────────────────────────────────────────────────────── -->
  {whyMe && whyMe.length > 0 && (
    <section class="section" data-reveal>
      <div class="container why-me-inner">
        <div class="why-me-label">
          <span class="section-label">Why me</span>
        </div>
        <ul class="why-me-list">
          {whyMe.map((point) => (
            <li class="why-me-item" data-reveal-child>
              <span class="why-me-bullet" aria-hidden="true">→</span>
              <span class="why-me-text">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── Related clients ────────────────────────────────────────────────── -->
  {relatedClients.length > 0 && (
    <section class="section section--surface" data-reveal>
      <div class="container">
        <span class="section-label">Clients in this space</span>
        <div class="clients-grid">
          {relatedClients.map(({ slug, data: client }) => (
            <a href={`/clients/${slug}`} class="client-card" data-reveal-child>
              <div class="client-logo-wrap">
                {client.logo ? (
                  <img
                    src={client.logo}
                    alt={client.name}
                    class="client-logo logo-adaptive"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="client-initial" aria-hidden="true">{client.name.charAt(0)}</span>
                )}
              </div>
              <span class="client-name">{client.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── CTA ────────────────────────────────────────────────────────────── -->
  <section class="cta-section" data-reveal>
    <div class="container cta-inner">
      <h2 class="cta-headline">{ctaHeadline ?? `Working in ${name}?`}</h2>
      <p class="cta-subhead">{ctaSubhead ?? "I'm always open to the right project or role."}</p>
      <div class="cta-buttons">
        <a href="/#contact" class="btn btn-primary">Get in touch</a>
        <a href="/experience" class="btn btn-outline">View all clients</a>
      </div>
    </div>
  </section>

  <!-- ── Footer ─────────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:kris@krisburger.com">Email</a>
      </nav>
    </div>
  </footer>

</BaseLayout>

<style>
  /* ── Header ───────────────────────────────────────── */
  .industry-header {
    padding: 120px 0 80px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .industry-header[style*="background-image"]::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: 0.88;
  }
  .header-inner {
    position: relative;
    max-width: 720px;
  }
  .header-eyebrow {
    display: block;
    margin-bottom: 20px;
  }
  .header-name {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1.1;
    margin-bottom: 8px;
  }
  .header-name-sub {
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0 0 20px;
    font-family: var(--font-heading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 500;
  }
  .header-description {
    font-size: 18px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 20px 0 0;
    max-width: 600px;
  }

  /* ── Sections ─────────────────────────────────────── */
  .section { padding: 120px 0; }
  .section--surface { background: var(--color-surface); }
  .section-label { display: block; margin-bottom: 32px; }

  /* ── Key Challenges ───────────────────────────────── */
  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .challenge-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 24px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .challenge-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .challenge-text {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 1.5;
  }

  /* ── Why Me ───────────────────────────────────────── */
  .why-me-inner {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 768px) {
    .why-me-inner { grid-template-columns: 1fr; gap: 24px; }
  }
  .why-me-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .why-me-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .why-me-bullet {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .why-me-text {
    font-size: 17px;
    color: var(--color-text);
    line-height: 1.6;
  }

  /* ── Related clients ──────────────────────────────── */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
  }
  .client-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 20px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .client-card:hover { border-color: var(--color-text-muted); }
  .client-logo-wrap {
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .client-logo {
    max-height: 40px;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }
  .client-card:hover .client-logo { opacity: 1; filter: grayscale(0); }
  .logo-adaptive { }
  [data-theme="dark"] .logo-adaptive { filter: invert(1) grayscale(1); }
  [data-theme="dark"] .client-card:hover .logo-adaptive { filter: invert(1) grayscale(0); }
  .client-initial {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .client-name {
    font-size: 13px;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.4;
  }

  /* ── CTA ──────────────────────────────────────────── */
  .cta-section { padding: 96px 0; text-align: center; }
  .cta-inner { max-width: 560px; margin: 0 auto; }
  .cta-headline {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }
  .cta-subhead { font-size: 17px; color: var(--color-text-muted); margin: 0 0 40px; }
  .cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  /* ── Footer ───────────────────────────────────────── */
  .footer { border-top: 1px solid var(--color-border); padding: 32px 0; }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { font-size: 14px; color: var(--color-text-muted); transition: color 0.2s ease; }
  .footer-links a:hover { color: var(--color-text); }
</style>
