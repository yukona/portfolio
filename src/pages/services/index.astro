---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const services = [...allServices].sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Services — Kris Burger"
  description="Design services from Kris Burger: UX design, design systems, brand identity, product design, and web design & development."
>
  <!-- ── Page header ───────────────────────────────────────── -->
  <header class="page-header">
    <div class="container">
      <p class="section-label" data-reveal>What I offer</p>
      <h1 class="page-headline" data-reveal>Services</h1>
      <p class="page-subhead" data-reveal>
        Forecasting, concepting and designing — from product and brand strategy<br class="hide-mobile" />
        through shipped digital experiences.
      </p>
    </div>
  </header>

  <!-- ── Services grid ────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="services-grid" data-reveal>
        {services.map((service) => (
          <a href={`/services/${service.id}`} class="service-card" data-reveal-child data-cursor-grow>
            <div class="card-body">
              <h2 class="card-title">{service.data.title}</h2>
              <p class="card-subhead">{service.data.subhead}</p>
            </div>
            <span class="card-cta">
              Learn more
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────── -->
  <section class="cta-section" data-reveal>
    <div class="container cta-inner">
      <h2 class="cta-headline">Not sure what you need?</h2>
      <p class="cta-subhead">Tell me about your project and we'll figure it out together.</p>
      <a href="/#contact" class="btn btn-primary">Get in touch</a>
    </div>
  </section>

  <!-- ── Footer ───────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:kris@krisburger.com">Email</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  .page-header {
    padding: 120px 0 80px;
    border-bottom: 1px solid var(--color-border);
  }
  .page-headline {
    font-size: clamp(40px, 6vw, 72px);
    color: var(--color-text);
    margin: 16px 0 24px;
  }
  .page-subhead {
    font-size: 18px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 600px;
  }
  .hide-mobile { display: none; }
  @media (min-width: 768px) { .hide-mobile { display: inline; } }

  .section { padding: 96px 0; }

  /* ── Services grid ─────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 960px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .services-grid { grid-template-columns: 1fr; } }

  .service-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .service-card:hover {
    border-color: var(--color-text-muted);
    transform: translateY(-2px);
  }
  .card-body { flex: 1; }
  .card-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 12px;
  }
  .card-subhead {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .service-card:hover .card-cta {
    color: var(--color-text);
    gap: 10px;
  }

  /* ── CTA ──────────────────────────────────────── */
  .cta-section { padding: 96px 0; text-align: center; }
  .cta-inner { max-width: 760px; margin: 0 auto; }
  .cta-headline {
    font-size: clamp(28px, 4vw, 40px);
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .cta-subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    margin: 0 0 40px;
  }

  /* ── Footer ───────────────────────────────────── */
  .footer { border-top: 1px solid var(--color-border); padding: 32px 0; }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
