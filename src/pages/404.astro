---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Kris Burger"
  description="The page you're looking for doesn't exist."
>
  <div class="page-wrap">
    <div class="not-found">
      <div class="container not-found-inner">
        <p class="not-found-code">404</p>
        <h1 class="not-found-headline">Nothing here.</h1>
        <p class="not-found-sub">
          The page you're looking for doesn't exist or has moved.
        </p>
        <div class="not-found-links">
          <a href="/" class="btn btn-primary">Go home</a>
          <a href="/#work" class="btn btn-outline">View work</a>
        </div>
      </div>
    </div>

    <footer class="footer">
      <div class="container footer-inner">
        <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:kris@krisburger.com">Email</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .not-found {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 96px 0;
  }
  .not-found-inner {
    text-align: center;
    max-width: 480px;
  }
  .not-found-code {
    font-family: var(--font-heading);
    font-size: 120px;
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--color-border);
    line-height: 1;
    margin: 0 0 24px;
  }
  .not-found-headline {
    font-size: clamp(32px, 5vw, 48px);
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .not-found-sub {
    font-size: 17px;
    color: var(--color-text-muted);
    margin: 0 0 48px;
    line-height: 1.6;
  }
  .not-found-links {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
