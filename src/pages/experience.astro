---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allClients    = await getCollection('clients');
const allIndustries = await getCollection('industries');

// Non-protected first, then alphabetical
const clients = [...allClients].sort((a, b) => {
  if (a.data.protected !== b.data.protected) return a.data.protected ? 1 : -1;
  return a.data.name.localeCompare(b.data.name);
});

// Sort industries: those with matching clients first
const industries = [...allIndustries].sort((a, b) => {
  const aHas = allClients.filter(c => c.data.industry?.includes(a.data.name)).length;
  const bHas = allClients.filter(c => c.data.industry?.includes(b.data.name)).length;
  return bHas - aHas;
});
---

<BaseLayout
  title="Experience — Kris Burger"
  description="A selection of the startups, scaleups and enterprise companies Kris Burger has worked with across cybersecurity, communications, fintech and more."
>
  <!-- ── Page header ───────────────────────────────────────────── -->
  <header class="page-header">
    <div class="container">
      <p class="page-eyebrow section-label" data-reveal>Who I've worked with</p>
      <h1 class="page-headline" data-reveal>Experience</h1>
      <p class="page-subhead" data-reveal>
        A selection of the startups, scaleups and enterprise companies<br class="hide-mobile" />
        I've had the privilege of working with.
      </p>
    </div>
  </header>

  <!-- ── Stats bar ────────────────────────────────────────────── -->
  <div class="stats-bar" data-reveal>
    <div class="container stats-inner">
      <div class="stat">
        <span class="stat-value">10+</span>
        <span class="stat-label">Years experience</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">20+</span>
        <span class="stat-label">Clients worldwide</span>
      </div>
    </div>
  </div>

  <!-- ── Clients list ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <span class="section-label" data-reveal>Companies</span>
      <p class="work-intro" data-word-reveal>The startups, scaleups and enterprises shaping what comes next.</p>
      <div class="projects-list" data-reveal>
        {clients.map((c, i) => (
          <ProjectCard
            slug={c.id}
            name={c.data.name}
            summary={c.data.summary}
            services={c.data.services}
            dateRange={c.data.dateRange}
            featuredImage={c.data.featuredImage}
            logo={c.data.logo}
            logoDark={c.data.logoDark}
            companyDescription={c.data.companyDescription}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Industries grid ──────────────────────────────────────── -->
  <section class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>Industries</span>
      <p class="work-intro" data-word-reveal>Sectors I've worked across, from early-stage disruption to enterprise scale.</p>
      <div class="industries-grid" data-reveal>
        {industries.map((industry) => {
          const relatedClients = allClients
            .filter(c => c.data.industry?.includes(industry.data.name))
            .map(c => c.data);
          return (
            <div class="industry-card" data-reveal-child>
              <div class="industry-body">
                <h3 class="industry-name">{industry.data.name}</h3>
                <p class="industry-desc">{industry.data.description}</p>
              </div>
              {relatedClients.length > 0 && (() => {
                const MAX = 3;
                const visible = relatedClients.slice(0, MAX);
                const overflow = relatedClients.length - MAX;
                return (
                  <div class="industry-tags">
                    {visible.map((c) => (
                      <span class="industry-tag" data-tooltip={c!.companyDescription ?? undefined}>
                        <span class="tag-name">{c!.name}</span>
                      </span>
                    ))}
                    {overflow > 0 && (
                      <span class="industry-tag industry-tag--overflow">+{overflow}</span>
                    )}
                  </div>
                );
              })()}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────── -->
  <section class="cta-section" data-reveal>
    <div class="container cta-inner">
      <h2 class="cta-headline">Working on something interesting?</h2>
      <p class="cta-subhead">I'm always open to the right project or role.</p>
      <div class="cta-buttons">
        <a href="/#contact" class="btn btn-primary">Get in touch</a>
        <a href="/#work"    class="btn btn-outline">View work</a>
      </div>
    </div>
  </section>

  <!-- ── Footer ───────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:kris@krisburger.com">Email</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<script>
  const TOOLTIP_WIDTH  = 260;
  const TOOLTIP_HEIGHT = 120; // approximate
  document.querySelectorAll<HTMLElement>('.industry-tag[data-tooltip]').forEach((tag) => {
    tag.addEventListener('mouseenter', () => {
      const rect   = tag.getBoundingClientRect();
      const vw     = window.innerWidth;
      const center = rect.left + rect.width / 2;

      // Horizontal
      tag.classList.remove('tt-pin-left', 'tt-pin-right');
      if (center - TOOLTIP_WIDTH / 2 < 8) {
        tag.classList.add('tt-pin-left');
      } else if (center + TOOLTIP_WIDTH / 2 > vw - 8) {
        tag.classList.add('tt-pin-right');
      }

      // Vertical — flip below if not enough room above
      tag.classList.remove('tt-below');
      if (rect.top < TOOLTIP_HEIGHT + 16) {
        tag.classList.add('tt-below');
      }
    });
  });
</script>

<style>
  /* ── Page header ──────────────────────────────────── */
  .page-header {
    padding: 120px 0 64px;
  }
  .page-eyebrow { margin-bottom: 16px; }
  .page-headline {
    font-size: clamp(40px, 6vw, 72px);
    color: var(--color-text);
    margin-bottom: 24px;
  }
  .page-subhead {
    font-size: 18px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 560px;
  }
  .hide-mobile { display: none; }
  @media (min-width: 768px) { .hide-mobile { display: inline; } }

  /* ── Section intro ────────────────────────────────── */
  .work-intro {
    font-size: clamp(26px, 3.5vw, 48px);
    font-family: var(--font-heading);
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.35;
    letter-spacing: -0.02em;
    max-width: 900px;
    margin: 0 0 48px;
  }

  /* ── Stats bar ────────────────────────────────────── */
  .stats-bar {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .stats-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 48px 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex: 1;
    text-align: center;
  }
  .stat-value {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1;
  }
  .stat-label {
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }
  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--color-border);
    flex-shrink: 0;
  }
  @media (max-width: 480px) {
    .stats-inner { padding: 32px 0; }
    .stat-divider { height: 32px; }
  }

  /* ── Sections ─────────────────────────────────────── */
  .section { padding: 96px 0; }
  .section--surface {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Clients list ─────────────────────────────────── */
  .projects-list { display: flex; flex-direction: column; }

  /* ── Industries grid ──────────────────────────────── */
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 64px;
    row-gap: 56px;
  }
  @media (max-width: 640px) {
    .industries-grid { grid-template-columns: 1fr; }
  }

  .industry-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .industry-body { flex: 1; }
  .industry-name {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  .industry-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .industry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .industry-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
  }
  .industry-tag--overflow {
    padding: 5px 10px;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  /* Tag tooltip */
  .industry-tag[data-tooltip] {
    position: relative;
    cursor: default;
  }
  .industry-tag[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: 260px;
    background: var(--color-text);
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-bg);
    white-space: normal;
    text-align: left;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
    z-index: 200;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  .industry-tag[data-tooltip]:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  /* Pinned left: tooltip anchors to left edge of tag */
  .industry-tag.tt-pin-left::after {
    left: 0;
    transform: translateX(0) translateY(4px);
  }
  .industry-tag.tt-pin-left:hover::after {
    transform: translateX(0) translateY(0);
  }
  /* Pinned right: tooltip anchors to right edge of tag */
  .industry-tag.tt-pin-right::after {
    left: auto;
    right: 0;
    transform: translateX(0) translateY(4px);
  }
  .industry-tag.tt-pin-right:hover::after {
    transform: translateX(0) translateY(0);
  }
  /* Flip below when near top of viewport */
  .industry-tag.tt-below::after {
    bottom: auto;
    top: calc(100% + 8px);
    transform: translateX(-50%) translateY(-4px);
  }
  .industry-tag.tt-below:hover::after {
    transform: translateX(-50%) translateY(0);
  }
  .industry-tag.tt-below.tt-pin-left::after {
    transform: translateX(0) translateY(-4px);
  }
  .industry-tag.tt-below.tt-pin-left:hover::after {
    transform: translateX(0) translateY(0);
  }
  .industry-tag.tt-below.tt-pin-right::after {
    transform: translateX(0) translateY(-4px);
  }
  .industry-tag.tt-below.tt-pin-right:hover::after {
    transform: translateX(0) translateY(0);
  }
  .tag-logo {
    width: 16px;
    height: 16px;
    object-fit: contain;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .tag-initial {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 9px;
    font-weight: 500;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .tag-name {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ── CTA ──────────────────────────────────────────── */
  .cta-section {
    padding: 96px 0;
    text-align: center;
  }
  .cta-inner { max-width: 560px; margin: 0 auto; }
  .cta-headline {
    font-size: clamp(28px, 4vw, 44px);
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .cta-subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    margin: 0 0 40px;
  }
  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Footer ───────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
  }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
