---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const clients = await getCollection('clients');
  return clients.map((client) => ({
    params: { slug: client.id },
    props: { client },
  }));
}

const { client } = Astro.props;
const {
  name,
  logo,
  logoDark,
  industry,
  dateRange,
  summary,
  pageTitle,
  metaDescription,
  protected: isProtected,
  password,
  projects,
} = client.data;

const clientId = client.id;
---

<BaseLayout
  title={pageTitle ?? `${name} — Kris Burger`}
  description={metaDescription ?? summary}
>
  <!-- ── Password gate ───────────────────────────────────────────────────── -->
  {isProtected && (
    <div id="client-gate" class="gate">
      <div class="gate-card">
        <div class="gate-lock">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h2 class="gate-heading">{name}</h2>
        <p class="gate-subhead">This work is protected. Enter the password to continue.</p>
        <form id="gate-form" class="gate-form" novalidate>
          <input
            id="gate-input"
            type="password"
            placeholder="Enter password"
            autocomplete="current-password"
            class="gate-input"
            required
          />
          <button type="submit" class="btn btn-primary gate-btn">View work</button>
        </form>
        <p id="gate-error" class="gate-error" role="alert" aria-live="polite"></p>
      </div>
    </div>
  )}

  <!-- ── Page content ────────────────────────────────────────────────────── -->
  <div id="client-content" hidden={isProtected ? true : undefined}>

    <!-- ── Page header ──────────────────────────────────────────────────── -->
    <header class="client-header">
      <div class="container">
        <div class="header-inner">
          <div class="header-left" data-reveal>
            <span class="header-eyebrow">{[...industry, dateRange].filter(Boolean).join(' · ')}</span>
            <h1 class="header-name">{name}</h1>
            <p class="header-summary">{summary}</p>
          </div>
          <div class="header-right" data-reveal>
            {logo && logoDark ? (
              <>
                <img src={logo}     alt={`${name} logo`} class="header-logo logo-light" loading="eager" decoding="async" />
                <img src={logoDark} alt={`${name} logo`} class="header-logo logo-dark"  loading="eager" decoding="async" />
              </>
            ) : logo ? (
              <img src={logo} alt={`${name} logo`} class="header-logo logo-adaptive" loading="eager" decoding="async" />
            ) : null}
          </div>
        </div>
      </div>
    </header>

    <!-- ── Projects ─────────────────────────────────────────────────────── -->
    <div class="projects-list">
      {projects.map((project, index) => (
        <section
          class={`project-section${index % 2 === 1 ? ' project-section--flip' : ''}${index === projects.length - 1 ? ' project-section--last' : ''}`}
          data-reveal
        >
          <div class="container">
            <div class={`project-layout${!project.image ? ' project-layout--full' : ''}`}>

              <!-- Content side -->
              <div class="project-content">
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="project-tag">{tag}</span>
                  ))}
                </div>
                <h2 class="project-title">{project.title}</h2>
                <span class="project-year">{project.year}</span>
                <p class="project-description">{project.description}</p>
                <div class="project-outcome">
                  <span class="outcome-label">Outcome</span>
                  <p class="outcome-text">{project.outcome}</p>
                </div>
                {project.liveUrl && (
                  <a href={project.liveUrl} target="_blank" rel="noopener" class="project-link">
                    View project →
                  </a>
                )}
              </div>

              <!-- Image side -->
              {project.image ? (
                <div class="project-image">
                  <img
                    src={project.image}
                    alt={project.imageAlt ?? project.title}
                    class="project-img"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="project-image">
                  <div class="project-img-placeholder" aria-hidden="true"></div>
                </div>
              )}

            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- ── CTA ──────────────────────────────────────────────────────────── -->
    <section class="cta-section" data-reveal>
      <div class="container cta-inner">
        <h2 class="cta-headline">Worked with {name}?</h2>
        <p class="cta-subhead">I'm always open to the right project or role.</p>
        <div class="cta-buttons">
          <a href="/#contact" class="btn btn-primary">Get in touch</a>
          <a href="/#work" class="btn btn-outline">View all work</a>
        </div>
      </div>
    </section>

    <!-- ── Footer ───────────────────────────────────────────────────────── -->
    <footer class="footer">
      <div class="container footer-inner">
        <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://angel.co/krisburger" target="_blank" rel="noopener">AngelList</a>
          <a href="mailto:kris@krisburger.com">Email</a>
        </nav>
      </div>
    </footer>

  </div><!-- /client-content -->
</BaseLayout>

<!-- ── Gate script ────────────────────────────────────────────────────────── -->
{isProtected && (
  <script is:inline define:vars={{ pw: password ?? '', clientId }}>
    const STORAGE_KEY = `client-unlocked-${clientId}`;
    const gate = document.getElementById('client-gate');
    const content = document.getElementById('client-content');

    if (sessionStorage.getItem(STORAGE_KEY) === 'true') {
      gate?.remove();
      content?.removeAttribute('hidden');
    }

    document.getElementById('gate-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const input = document.getElementById('gate-input');
      const val = (input && input.value) ? input.value.trim() : '';
      const errorEl = document.getElementById('gate-error');

      if (val.toLowerCase() === pw.toLowerCase()) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        if (gate) {
          gate.style.opacity = '0';
          gate.style.pointerEvents = 'none';
        }
        setTimeout(function() {
          gate?.remove();
          content?.removeAttribute('hidden');
        }, 400);
      } else {
        if (errorEl) errorEl.textContent = 'Incorrect password';
        if (input) {
          input.value = '';
          input.focus();
        }
      }
    });
  </script>
)}

<style>
  /* ── Gate ─────────────────────────────────────────── */
  .gate {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    transition: opacity 0.4s ease;
  }
  .gate-card {
    max-width: 400px;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 48px 40px;
    text-align: center;
  }
  .gate-lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    margin: 0 auto 24px;
  }
  .gate-heading {
    font-size: 22px;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 12px;
  }
  .gate-subhead {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 32px;
  }
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .gate-input {
    width: 100%;
    padding: 14px 16px;
    font-size: 15px;
    font-family: var(--font-body);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .gate-input:focus { border-color: var(--color-accent); }
  .gate-btn { justify-content: center; }
  .gate-error {
    margin-top: 8px;
    font-size: 14px;
    color: #e55;
    min-height: 20px;
  }

  /* ── Header ───────────────────────────────────────── */
  .client-header {
    padding: 120px 0 64px;
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  .header-eyebrow {
    display: block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }
  .header-name {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1.1;
  }
  .header-summary {
    font-size: 18px;
    color: var(--color-text-muted);
    margin: 16px 0 0;
    line-height: 1.6;
    max-width: 560px;
  }
  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
  }
  .header-logo {
    max-height: 48px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.5;
  }
  /* Dark mode logo handling */
  .logo-dark { display: none; }
  [data-theme="dark"] .logo-light { display: none; }
  [data-theme="dark"] .logo-dark  { display: block; }
  [data-theme="dark"] .logo-adaptive { filter: invert(1) grayscale(1); }
  @media (max-width: 640px) {
    .header-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .header-right {
      justify-content: flex-start;
      order: -1;
    }
  }

  /* ── Projects list ────────────────────────────────── */
  .projects-list { border-bottom: 1px solid var(--color-border); }

  .project-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .project-section--last { border-bottom: none; }

  .project-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .project-layout--full {
    grid-template-columns: 1fr;
  }
  .project-layout--full .project-content {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
  }
  .project-layout--full .project-image { display: none; }

  /* Flip: content left, image right → reverse order */
  .project-section--flip .project-image { order: 2; }
  .project-section--flip .project-content { order: 1; }

  /* Content side */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 4px;
  }
  .project-tag {
    font-size: 11px;
    font-family: var(--font-heading);
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 3px 10px;
    letter-spacing: 0.01em;
  }
  .project-title {
    font-size: 28px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-top: 12px;
    line-height: 1.2;
  }
  .project-year {
    display: block;
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: 4px;
  }
  .project-description {
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 16px 0 0;
    max-width: 520px;
  }
  .project-outcome {
    margin-top: 24px;
    padding-left: 16px;
    border-left: 2px solid var(--color-text-muted);
  }
  .outcome-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .outcome-text {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    line-height: 1.5;
  }
  .project-link {
    display: inline-block;
    margin-top: 24px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .project-link:hover { border-color: var(--color-text); }

  /* Image side */
  .project-img {
    width: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
    aspect-ratio: 16 / 10;
    display: block;
  }
  .project-img-placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  /* Mobile: stack vertically, image above content */
  @media (max-width: 768px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .project-section--flip .project-image { order: 1; }
    .project-section--flip .project-content { order: 2; }
    .project-image { order: 1; }
    .project-content { order: 2; }
    .project-layout--full .project-content { max-width: 100%; }
  }

  /* ── CTA ──────────────────────────────────────────── */
  .cta-section {
    padding: 96px 0;
    text-align: center;
  }
  .cta-inner { max-width: 560px; margin: 0 auto; }
  .cta-headline {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }
  .cta-subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    margin: 0 0 40px;
  }
  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Footer ───────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
  }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
