---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import LogoTicker from '../components/LogoTicker.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects.find((p) => p.data.featured);
const rest = allProjects
  .filter((p) => !p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const experience = [
  {
    company: 'Palo Alto Networks / Prisma Cloud',
    role: 'Design Lead',
    years: '2019–2024',
    description:
      "Led design across Prisma Cloud's 6 product surfaces. Built the design system, established design operations, and grew the design org from 3 to 12.",
  },
  {
    company: 'Aporeto (acq. by Palo Alto Networks)',
    role: 'Founding Designer & Design Lead',
    years: '2016–2019',
    description:
      'First design hire at a zero-trust security startup. Owned all design from brand identity through product to acquisition.',
  },
  {
    company: 'Dialpad / UberConference',
    role: 'Product Designer',
    years: '2013–2016',
    description:
      'Redesigned the core call experience for a cloud communications platform used by 100k+ teams. Shipped on web and mobile.',
  },
];
---

<BaseLayout
  title="Kris Burger — Design Lead"
  description="Design Lead with 10+ years building products, brands and teams."
>
  <!-- ─────────────────────────────────────────── HERO ── -->
  <section id="hero" class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <h1 class="hero-headline text-hero">
          Design for<br />
          <span id="cycling-text" class="hero-cycling">scaling high-growth startups</span><span class="hero-dot">.</span>
        </h1>
        <p class="hero-subhead">
          Design Lead with 10+ years building products,<br class="hide-mobile" /> brands and teams.
        </p>
        <div class="hero-ctas">
          <a href="#work" class="btn btn-primary">View work</a>
          <a href="#contact" class="btn btn-outline">Get in touch</a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#work" class="scroll-indicator" aria-label="Scroll to work">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <polyline points="19 12 12 19 5 12"/>
      </svg>
    </a>
  </section>

  <!-- ────────────────────────────────────── SELECTED WORK ── -->
  <section id="work" class="section">
    <div class="container">
      <span class="section-label" data-reveal>Selected work</span>

      {featured && (
        <div class="featured-wrap" data-reveal>
          <ProjectCard
            slug={featured.id}
            title={featured.data.title}
            description={featured.data.description}
            tags={featured.data.tags}
            year={featured.data.year}
            thumbnail={featured.data.thumbnail}
            featured={true}
            index={0}
          />
        </div>
      )}

      {rest.length > 0 && (
        <div class="projects-grid" data-reveal>
          {rest.map((p, i) => (
            <ProjectCard
              slug={p.id}
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              year={p.data.year}
              thumbnail={p.data.thumbnail}
              featured={false}
              index={i + 1}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ─────────────────────────────────────────── SERVICES ── -->
  <section id="services" class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>What I do</span>
      <div class="services-grid" data-reveal>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Product design</h3>
          <p class="service-desc">From concept to shipped. Responsive web apps, mobile, design systems.</p>
        </div>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Brand &amp; identity</h3>
          <p class="service-desc">Strategy to execution. Frameworks, visual language, scalable systems.</p>
        </div>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Team &amp; process</h3>
          <p class="service-desc">Design leadership, mentoring, research operations, cross-functional collaboration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── EXPERIENCE ── -->
  <section id="experience" class="section">
    <div class="container section-2col">
      <div class="section-2col-label">
        <span class="section-label" data-reveal>Experience</span>
      </div>
      <div class="section-2col-content" data-reveal>
        <Timeline entries={experience} />
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── PROCESS ── -->
  <section id="process" class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>How I work</span>
      <div class="process-grid" data-reveal>
        {[
          { num: '01', title: 'Discover', desc: 'Research, audits, stakeholder interviews' },
          { num: '02', title: 'Define',   desc: 'Frameworks, principles, problem framing' },
          { num: '03', title: 'Design',   desc: 'Concepts, prototypes, iteration' },
          { num: '04', title: 'Deliver',  desc: 'Handoff, QA, measurement' },
        ].map((step) => (
          <div class="process-step" data-reveal-child>
            <span class="process-num">{step.num}</span>
            <h3 class="process-title">{step.title}</h3>
            <p class="process-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── CLIENTS ── -->
  <section id="clients" class="section">
    <div class="container">
      <span class="section-label" data-reveal>Trusted by</span>
    </div>
    <div data-reveal>
      <LogoTicker />
    </div>
  </section>

  <!-- ─────────────────────────────────────────── TESTIMONIALS ── -->
  <section id="testimonials" class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>What people say</span>
      <div class="testimonials-grid" data-reveal>
        <TestimonialCard
          quote="Kris has a rare ability to zoom out to strategy while staying hands-on with execution. He transformed how our design team operates and shipped a design system that actually got adopted."
          name="Alex Rivera"
          title="VP of Engineering"
          company="Prisma Cloud"
        />
        <TestimonialCard
          quote="Working with Kris was the best design investment we made. He took a product nobody could explain and made it something customers could fall in love with."
          name="Priya Mehta"
          title="CEO & Co-founder"
          company="Aporeto"
        />
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── ABOUT ── -->
  <section id="about" class="section">
    <div class="container about-grid">
      <div class="about-text" data-reveal>
        <span class="section-label">About</span>
        <h2 class="text-section about-headline">I design products that scale.</h2>
        <p>
          I'm a Design Lead based in San Francisco with over a decade of experience building products, brands, and teams at high-growth startups and enterprise companies.
        </p>
        <p>
          My approach combines a strong visual sensibility with systems thinking. I believe the best design work is invisible — products that feel inevitable, not engineered.
        </p>
        <p>
          When I'm not pushing pixels, I'm usually trail running, reading about cognitive science, or cooking something that takes longer than it should.
        </p>
        <a href="/resume.pdf" class="btn btn-outline" download style="margin-top: 32px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download resume
        </a>
      </div>
      <div class="about-visual" data-reveal>
        <!-- Typographic statement (option b) — swap for <img> + greyscale class if desired -->
        <div class="about-statement">
          <p class="statement-text">
            "Good design is as little design as possible."
          </p>
          <span class="statement-attr">— Dieter Rams</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── CONTACT ── -->
  <section id="contact" class="section section--surface">
    <div class="container contact-inner">
      <div class="contact-header" data-reveal>
        <span class="section-label">Let's talk</span>
        <h2 class="text-section">Working on something interesting?</h2>
        <p class="contact-subhead">I'm open to select freelance and advisory projects. Reach out and let's figure out if we're a good fit.</p>
      </div>

      <form
        class="contact-form"
        name="contact"
        method="POST"
        netlify
        netlify-honeypot="bot-field"
        data-reveal
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" /></label>
        </p>
        <div class="form-row">
          <div class="form-field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Your name" required />
          </div>
          <div class="form-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="form-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Tell me about your project..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
      </form>

      <div class="contact-links" data-reveal>
        <a href="mailto:kris@krisburger.com" class="contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          kris@krisburger.com
        </a>
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener" class="contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>
        <a href="https://angel.co/krisburger" target="_blank" rel="noopener" class="contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          AngelList
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── FOOTER ── -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://angel.co/krisburger" target="_blank" rel="noopener">AngelList</a>
        <a href="mailto:kris@krisburger.com">Email</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<!-- ─────────────────────────────────────── HERO CYCLING TEXT ── -->
<script>
  const phrases = [
    'scaling high-growth startups',
    'leading design systems',
    'shaping product experiences',
    'building brands',
  ];
  let idx = 0;
  const el = document.getElementById('cycling-text');

  if (el) {
    setInterval(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      setTimeout(() => {
        idx = (idx + 1) % phrases.length;
        el.textContent = phrases[idx];
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      }, 300);
    }, 3000);
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 128px 0 96px;
  }
  .hero-inner { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .hero-content { max-width: 900px; }
  .hero-headline {
    color: var(--color-text);
    margin-bottom: 32px;
  }
  .hero-cycling {
    display: inline-block;
    transition: opacity 0.3s ease, transform 0.3s ease;
    color: var(--color-text-muted);
  }
  .hero-dot { color: var(--color-text); }
  .hero-subhead {
    font-size: 20px;
    color: var(--color-text-muted);
    margin: 0 0 48px;
    line-height: 1.6;
  }
  .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .hide-mobile { display: none; }
  @media (min-width: 768px) { .hide-mobile { display: inline; } }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    animation: bounce 2s ease-in-out infinite;
    display: flex;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  /* ── Sections ─────────────────────────────────────── */
  .section { padding: 96px 0; }
  .section--surface { background: var(--color-surface); }

  /* ── Work ─────────────────────────────────────────── */
  .featured-wrap { margin-bottom: 32px; }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  @media (max-width: 640px) {
    .projects-grid { grid-template-columns: 1fr; }
  }

  /* ── Services ─────────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    border-top: 1px solid var(--color-border);
    padding-top: 48px;
  }
  .service-title {
    font-family: var(--font-heading);
    font-size: 20px;
    color: var(--color-text);
    margin-bottom: 12px;
  }
  .service-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 768px) {
    .services-grid { grid-template-columns: 1fr; gap: 32px; }
  }

  /* ── Experience 2-col ─────────────────────────────── */
  .section-2col {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 64px;
    align-items: start;
  }
  .section-2col-label { padding-top: 6px; }
  .section-2col-label .section-label { margin-bottom: 0; }
  @media (max-width: 768px) {
    .section-2col { grid-template-columns: 1fr; gap: 32px; }
  }

  /* ── Process ──────────────────────────────────────── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    border-top: 1px solid var(--color-border);
    padding-top: 48px;
  }
  .process-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 300;
    color: var(--color-border);
    line-height: 1;
    margin-bottom: 16px;
  }
  .process-title {
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--color-text);
    margin-bottom: 8px;
  }
  .process-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .process-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .process-grid { grid-template-columns: 1fr; }
  }

  /* ── Testimonials ─────────────────────────────────── */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (max-width: 640px) {
    .testimonials-grid { grid-template-columns: 1fr; }
  }

  /* ── About ────────────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .about-headline {
    color: var(--color-text);
    margin-bottom: 32px;
    margin-top: 16px;
  }
  .about-text p {
    color: var(--color-text-muted);
    margin: 0 0 20px;
    font-size: 16px;
  }
  .about-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: 48px;
  }
  .about-statement { text-align: center; }
  .statement-text {
    font-family: var(--font-heading);
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 300;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.5;
    margin: 0 0 16px;
  }
  .statement-attr {
    font-size: 13px;
    color: var(--color-text-muted);
  }
  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; gap: 48px; }
    .about-visual { min-height: 200px; }
  }

  /* ── Contact ──────────────────────────────────────── */
  .contact-inner { max-width: 720px; }
  .contact-subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    margin: 16px 0 48px;
  }
  .contact-form { display: flex; flex-direction: column; gap: 20px; margin-bottom: 48px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 580px) { .form-row { grid-template-columns: 1fr; } }
  .form-field { display: flex; flex-direction: column; gap: 8px; }
  .form-field label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }
  .form-field input,
  .form-field textarea {
    padding: 12px 16px;
    font-size: 16px;
    font-family: var(--font-body);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s ease;
    resize: vertical;
    width: 100%;
  }
  .form-field input:focus,
  .form-field textarea:focus { border-color: var(--color-accent); }
  .hidden { display: none !important; }

  .contact-links {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }
  .contact-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .contact-link:hover { color: var(--color-text); }

  /* ── Footer ───────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: 24px;
  }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
