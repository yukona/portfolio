---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import LogoTicker from '../components/LogoTicker.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { getCollection } from 'astro:content';

const allClients = (await getCollection('clients')).filter(c => c.data.published !== false);
const allTestimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const endYear = (s: string) => parseInt(s.split('–').pop()?.trim() ?? s);
const featuredClients = allClients
  .filter((c) => c.data.featuredWork)
  .sort((a, b) => endYear(b.data.dateRange) - endYear(a.data.dateRange));

const experience = [
  {
    company: 'Palo Alto Networks / Prisma Cloud',
    role: 'Design Lead',
    years: '2019–2024',
    description:
      "Led design across Prisma Cloud's 6 product surfaces. Built the design system, established design operations, and grew the design org from 3 to 12.",
  },
  {
    company: 'Aporeto (acq. by Palo Alto Networks)',
    role: 'Founding Designer & Design Lead',
    years: '2016–2019',
    description:
      'First design hire at a zero-trust security startup. Owned all design from brand identity through product to acquisition.',
  },
  {
    company: 'Dialpad / UberConference',
    role: 'Product Designer',
    years: '2013–2016',
    description:
      'Redesigned the core call experience for a cloud communications platform used by 100k+ teams. Shipped on web and mobile.',
  },
];
---

<BaseLayout
  title="Kris Burger — Design Lead"
  description="Design Lead forecasting, concepting and designing systems that shape the future."
>
  <!-- ─────────────────────────────────────────── HERO ── -->
  <section id="hero" class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <h1 class="hero-headline text-hero">
          Design for<br />
          <span id="cycling-text" class="hero-cycling">what comes next</span><span class="hero-dot">.</span>
        </h1>
        <p class="hero-subhead">
          Forecasting, developing concepts and designing<br class="hide-mobile" /> systems that shape the future.
        </p>
        <div class="hero-ctas">
          <a href="/experience" class="btn btn-primary">View experience</a>
          <button class="btn btn-outline" data-contact-trigger>Get in touch</button>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href="#work" class="scroll-indicator" aria-label="Scroll to work">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <polyline points="19 12 12 19 5 12"/>
      </svg>
    </a>
  </section>

  <!-- ────────────────────────────────────── SELECTED WORK ── -->
  <section id="work" class="section">
    <div class="container">
      <span class="section-label" data-reveal>Featured experience</span>
      <p class="work-intro" data-word-reveal>With over 10 years across agencies, startups, and global companies, I focus on building strong creative teams that deliver results.</p>

      <div class="projects-list" data-reveal>
        {featuredClients.map((c, i) => (
          <ProjectCard
            slug={c.id}
            name={c.data.name}
            summary={c.data.summary}
            services={c.data.services}
            dateRange={c.data.dateRange}
            featuredImage={c.data.featuredImage}
            logo={c.data.logo}
            logoDark={c.data.logoDark}
            companyDescription={c.data.companyDescription}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── SERVICES ── -->
  <section id="services" class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>What I do</span>
      <p class="work-intro" data-word-reveal>Sharp design thinking and hands-on execution — across product, brand, and everything in between.</p>
      <div class="services-grid" data-reveal>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Product Design</h3>
          <p class="service-desc">End-to-end product design across web, mobile (iOS & Android), and integrations — with a particular focus on 0-to-1 work for new companies finding their footing.</p>
        </div>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Brand &amp; Identity</h3>
          <p class="service-desc">Building new brands and evolving existing ones — from positioning and visual identity through to execution. Especially comfortable with 0-to-1 brand work for early-stage companies.</p>
        </div>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Development</h3>
          <p class="service-desc">Websites for SaaS companies built to convert — including conversion optimisation, ecommerce, and marketing sites that perform as well as they look.</p>
        </div>
        <div class="service-item" data-reveal-child>
          <h3 class="service-title">Ops & Leadership</h3>
          <p class="service-desc">Design strategy, team hiring, and mentorship for growing organisations. Also available for 0-to-1 brand and product design advisory at the founder or executive level.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ─────────────────────────────────────────── PROCESS ── -->
  <section id="process" class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>How I work</span>
      <p class="work-intro" data-word-reveal>A clear process makes the work better — and the collaboration easier.</p>
      <div class="process-grid" data-reveal>
        {[
          { num: '01', title: 'Discover', desc: 'Understand the problem before picking up a pen. Research, audits, and stakeholder conversations to find what actually matters.' },
          { num: '02', title: 'Define',   desc: 'Turn ambiguity into direction. Principles, frameworks, and a shared point of view that keeps everyone aligned as the work evolves.' },
          { num: '03', title: 'Design',   desc: 'Move fast through concepts, stay rigorous through iteration. The best ideas survive contact with real users and real constraints.' },
          { num: '04', title: 'Deliver',  desc: 'Shipping is part of the craft. Tight handoffs, QA, and measurement so the work performs as well in production as it did in the prototype.' },
        ].map((step) => (
          <div class="process-step" data-reveal-child>
            <span class="process-num">{step.num}</span>
            <h3 class="process-title">{step.title}</h3>
            <p class="process-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── CLIENTS ── -->
  <section id="clients" class="section">
    <div class="container">
      <span class="section-label" data-reveal>Trusted by</span>
    </div>
    <div data-reveal>
      <LogoTicker />
    </div>
  </section>

  <!-- ─────────────────────────────────────────── TESTIMONIALS ── -->
  <section id="testimonials" class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>What people say</span>
      <p class="work-intro" data-word-reveal>The measure of good work is what the people you did it with say afterwards.</p>

      <!-- Visible 2×1 grid (slots filled + cycled by JS) -->
      <div class="testimonials-grid" id="testimonials-grid" data-reveal>
        <div class="testimonial-slot" data-slot="0"></div>
        <div class="testimonial-slot" data-slot="1"></div>
      </div>

      <!-- Hidden pool: all cards pre-rendered for JS to clone -->
      <div id="testimonial-pool" aria-hidden="true" style="display:none">
        {allTestimonials.map((t) => (
          <div>
            <TestimonialCard
              quote={t.data.quote}
              name={t.data.name}
              title={t.data.title}
              company={t.data.company}
              avatar={t.data.avatar}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── ABOUT ── -->
  <section id="about" class="section">
    <div class="container about-centered">
      <div class="about-text" data-reveal>
        <span class="section-label">About</span>
        <h2 class="text-section about-headline" data-word-reveal>Using the latest tools, clear strategy and vision, I build systems that enable teams to deliver meaningful impact.</h2>
        <p>
          Based in Vancouver, I work with companies across the Bay Area and around the world — from early-stage startups to large enterprises. For me it's always been about the challenge: taking everything I've learned and applying it as a solution to the next hard problem.
        </p>
        <p>
          Those problems tend to find me in industries on the forefront of change — deep tech, cybersecurity, the future of work, AI — companies building things that are genuinely new. Part of that is staying current with how everything is evolving — constantly testing new tools, including AI, to find what actually makes the work sharper and the process faster.
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── FAQ ── -->
  <section id="faq" class="section section--surface">
    <div class="container faq-container">
      <span class="section-label" data-reveal>Common questions</span>
      <div class="faq-list" data-reveal>
        {[
          {
            q: 'Do you still design hands-on?',
            a: "Yes — always. Strategy and leadership are part of the work, but I stay close to the craft. I'm in Figma regularly, working through concepts, pushing pixels, and staying current with how tools and patterns are evolving.",
          },
          {
            q: 'How do you work with AI in your process?',
            a: "As a tool, not a shortcut. I use AI to accelerate ideation, explore directions faster, and reduce repetitive production work — while keeping creative direction and design judgement firmly human. The output gets better; the thinking stays rigorous.",
          },
          {
            q: 'What kinds of organizations do you work best with?',
            a: "Startups and scaleups with real problems to solve — teams that value clarity, move with intent, and want design to do more than make things look good. I'm equally comfortable as the first design hire or embedded in an established org.",
          },
          {
            q: 'What industries do you have the most experience in?',
            a: "Cybersecurity, SaaS, and fintech make up the bulk of my product work. On the brand and eCommerce side I've worked across consumer goods, retail, and professional services. I follow the problem more than the category.",
          },
          {
            q: 'What is your approach to design leadership?',
            a: "Give people clear direction, real ownership, and honest feedback — then get out of the way. I try to build environments where designers can do their best work, not just execute on a brief. Good leadership makes the work better and the team stronger.",
          },
          {
            q: 'What kinds of problems do you solve best?',
            a: "The ones without an obvious answer. 0-to-1 product design, complex platform overhauls, brand systems that need to scale, teams that need structure without losing momentum. I do well when the problem is still being defined.",
          },
        ].map((item, i) => (
          <div class="faq-item" data-index={i}>
            <button class="faq-trigger" aria-expanded="false" aria-controls={`home-faq-${i}`}>
              <span class="faq-question">{item.q}</span>
              <span class="faq-icon" aria-hidden="true">
                <svg class="icon-plus"  width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <svg class="icon-minus" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </span>
            </button>
            <div class="faq-body" id={`home-faq-${i}`} role="region">
              <p class="faq-answer">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── CONTACT ── -->
  <section id="contact" class="section section--surface">
    <div class="container contact-inner">
      <div class="contact-header" data-reveal>
        <span class="section-label">Let's talk</span>
        <h2 class="contact-headline" data-word-reveal>Working on something interesting?</h2>
        <p class="contact-subhead">I'm open to select freelance and advisory projects. Reach out and let's figure out if we're a good fit.</p>
      </div>

      <form
        class="contact-form"
        name="contact"
        method="POST"
        netlify
        netlify-honeypot="bot-field"
        data-reveal
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" /></label>
        </p>
        <div class="form-row">
          <div class="form-field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" placeholder="Your name" required />
          </div>
          <div class="form-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="your@email.com" required />
          </div>
        </div>
        <div class="form-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Tell me about your project..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
      </form>

      <div class="contact-links" data-reveal>
        <a href="mailto:kris@krisburger.com" class="contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          kris@krisburger.com
        </a>
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener" class="contact-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────── FOOTER ── -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="mailto:kris@krisburger.com">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          kris@krisburger.com
        </a>
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<!-- ─────────────────────────────────────── FAQ ACCORDION ── -->
<script>
  document.querySelectorAll('#faq .faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item   = btn.closest('.faq-item') as HTMLElement;
      const body   = item.querySelector('.faq-body') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('#faq .faq-item').forEach((el) => {
        const b = el.querySelector('.faq-body') as HTMLElement;
        const t = el.querySelector('.faq-trigger') as HTMLElement;
        el.classList.remove('is-open');
        t?.setAttribute('aria-expanded', 'false');
        if (b) b.style.maxHeight = '0';
      });

      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });
</script>

<!-- ─────────────────────────────────────── HERO CYCLING TEXT ── -->
<script>
  const phrases = [
    'what comes next',
    'systems that endure',
    'brands built to last',
    'the long view',
  ];
  let idx = 0;
  const el = document.getElementById('cycling-text');

  if (el) {
    // Paint in the highlight on initial load
    el.dataset.color = '0';
    setTimeout(() => el.classList.add('is-painted'), 300);

    setInterval(() => {
      // Instantly collapse the highlight (no transition) and fade out
      el.classList.remove('is-painted');
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';

      setTimeout(() => {
        // Swap text and cycle highlight color
        idx = (idx + 1) % phrases.length;
        el.textContent = phrases[idx];
        el.dataset.color = String(idx);
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';

        // Two rAFs to ensure clip-path reset is rendered before transition
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            el.classList.add('is-painted');
          });
        });
      }, 300);
    }, 3500);
  }
</script>

<script>
  // Testimonial grid cycling
  const TSLOTS    = 2;
  const FADE_MS   = 400;
  const CYCLE_MS  = 5000;

  const grid = document.getElementById('testimonials-grid');
  const pool = document.getElementById('testimonial-pool');
  if (grid && pool) {
    const poolItems = Array.from(pool.children); // each is a <div> wrapping a card
    const total     = poolItems.length;
    const slots     = Array.from(grid.querySelectorAll<HTMLElement>('.testimonial-slot'));

    function fillSlot(slot: HTMLElement, poolItem: Element) {
      while (slot.firstChild) slot.removeChild(slot.firstChild);
      const card = poolItem.firstElementChild!.cloneNode(true) as HTMLElement;
      // Ensure cloned reveal-children are visible immediately
      card.querySelectorAll('[data-reveal-child]').forEach((el) => el.classList.add('is-visible'));
      if (card.hasAttribute('data-reveal-child')) card.classList.add('is-visible');
      slot.appendChild(card);
    }

    // Fill initial 4 slots
    slots.forEach((slot, i) => {
      if (poolItems[i]) fillSlot(slot, poolItems[i]);
    });

    // Only cycle if there are more testimonials than slots
    if (total > TSLOTS) {
      let queueIdx = TSLOTS;
      let slotIdx  = 0;

      function cycleNext() {
        const slot = slots[slotIdx];
        slot.style.opacity = '0';
        setTimeout(() => {
          fillSlot(slot, poolItems[queueIdx % total]);
          slot.style.opacity = '1';
          slotIdx  = (slotIdx  + 1) % TSLOTS;
          queueIdx = (queueIdx + 1) % total;
          setTimeout(cycleNext, CYCLE_MS);
        }, FADE_MS);
      }

      setTimeout(cycleNext, CYCLE_MS * 2);
    }
  }
</script>

<style>
  /* ── Featured work intro ───────────────────────────── */
  .work-intro {
    font-size: clamp(26px, 3.5vw, 48px);
    font-family: var(--font-heading);
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.35;
    letter-spacing: -0.02em;
    max-width: 900px;
    margin: 24px 0 48px;
  }

  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 160px 0 120px;
  }
  .hero-inner { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .hero-content { max-width: 900px; }
  .hero-headline {
    color: var(--color-text);
    margin-bottom: 32px;
  }
  .hero-cycling {
    display: inline-block;
    white-space: nowrap;
    padding: 0.05em 0.2em 0.12em;
    border-radius: 8px;
    background: oklch(94.8% 0.028 342.258);
    color: var(--color-text);
    clip-path: inset(0 100% 0 0);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .hero-cycling.is-painted {
    clip-path: inset(0 0% 0 0);
    transition: opacity 0.3s ease, transform 0.3s ease, clip-path 0.55s cubic-bezier(0.25, 0.1, 0.25, 1.0);
  }
  .hero-dot { color: var(--color-text); }
  .hero-subhead {
    font-size: 21px;
    font-weight: 400;
    color: var(--color-text-muted);
    margin: 0 0 48px;
    line-height: 1.6;
  }
  .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .hide-mobile { display: none; }
  @media (min-width: 768px) { .hide-mobile { display: inline; } }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    animation: bounce 2s ease-in-out infinite;
    display: flex;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  /* ── Sections ─────────────────────────────────────── */
  .section { padding: 120px 0; }
  .section--surface {}

  /* ── Work ─────────────────────────────────────────── */
  .projects-list { display: flex; flex-direction: column; }

  /* ── Services ─────────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    padding-top: 48px;
  }
  .service-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 12px;
  }
  .service-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 768px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
  }

  /* ── Experience 2-col ─────────────────────────────── */
  .section-2col {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 64px;
    align-items: start;
  }
  .section-2col-label { padding-top: 6px; }
  .section-2col-label .section-label { margin-bottom: 0; }
  @media (max-width: 768px) {
    .section-2col { grid-template-columns: 1fr; gap: 32px; }
  }

  /* ── Process ──────────────────────────────────────── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-top: 48px;
  }
  .process-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 300;
    color: var(--color-border);
    line-height: 1;
    margin-bottom: 16px;
  }
  .process-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 8px;
  }
  .process-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .process-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .process-grid { grid-template-columns: 1fr; }
  }

  /* ── Testimonials ─────────────────────────────────── */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .testimonial-slot {
    transition: opacity 0.4s ease;
  }
  @media (max-width: 640px) {
    .testimonials-grid { grid-template-columns: 1fr; }
  }

  /* ── About ────────────────────────────────────────── */
  .about-centered {
    max-width: 960px;
    margin-inline: auto;
  }
  .about-headline {
