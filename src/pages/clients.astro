---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allClients    = await getCollection('clients');
const allIndustries = await getCollection('industries');

// Featured first, then alphabetical
const clients = [...allClients].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.name.localeCompare(b.data.name);
});

// Build a lookup map: slug → client data
const clientMap = Object.fromEntries(allClients.map((c) => [c.id, c.data]));

// Sort industries: those with clients first
const industries = [...allIndustries].sort((a, b) => {
  const aHas = a.data.clientSlugs.length;
  const bHas = b.data.clientSlugs.length;
  return bHas - aHas;
});
---

<BaseLayout
  title="Clients — Kris Burger"
  description="A selection of the startups, scaleups and enterprise companies Kris Burger has worked with across cybersecurity, communications, fintech and more."
>
  <!-- ── Page header ───────────────────────────────────────────── -->
  <header class="page-header">
    <div class="container">
      <p class="page-eyebrow section-label" data-reveal>Selected clients</p>
      <h1 class="page-headline" data-reveal>Clients</h1>
      <p class="page-subhead" data-reveal>
        A selection of the startups, scaleups and enterprise companies<br class="hide-mobile" />
        I've had the privilege of working with.
      </p>
    </div>
  </header>

  <!-- ── Stats bar ────────────────────────────────────────────── -->
  <div class="stats-bar" data-reveal>
    <div class="container stats-inner">
      <div class="stat">
        <span class="stat-value">10+</span>
        <span class="stat-label">Years experience</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">20+</span>
        <span class="stat-label">Clients worldwide</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">5</span>
        <span class="stat-label">Industries</span>
      </div>
    </div>
  </div>

  <!-- ── Clients grid ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <span class="section-label" data-reveal>Companies</span>
      <div class="clients-grid" data-reveal>
        {clients.map((client) => (
          <div class="client-cell" data-reveal-child>
            <div class="client-logo-wrap">
              {client.data.logo ? (
                <img
                  src={client.data.logo}
                  alt={client.data.name}
                  class="client-logo"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="client-logo-text">{client.data.name.charAt(0)}</span>
              )}
            </div>
            <span class="client-name">{client.data.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Industries grid ──────────────────────────────────────── -->
  <section class="section section--surface">
    <div class="container">
      <span class="section-label" data-reveal>Industries</span>
      <div class="industries-grid" data-reveal>
        {industries.map((industry) => {
          const relatedClients = industry.data.clientSlugs
            .map((slug) => clientMap[slug])
            .filter(Boolean);
          return (
            <div class="industry-card" data-reveal-child>
              <div class="industry-body">
                <h3 class="industry-name">{industry.data.name}</h3>
                <p class="industry-desc">{industry.data.description}</p>
              </div>
              {relatedClients.length > 0 && (
                <div class="industry-logos">
                  {relatedClients.slice(0, 4).map((c) => (
                    <div class="industry-logo-item" title={c!.name}>
                      {c!.logo ? (
                        <img
                          src={c!.logo}
                          alt={c!.name}
                          class="industry-logo-img"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="industry-logo-fallback">{c!.name.charAt(0)}</span>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────── -->
  <section class="cta-section" data-reveal>
    <div class="container cta-inner">
      <h2 class="cta-headline">Working on something interesting?</h2>
      <p class="cta-subhead">I'm always open to the right project or role.</p>
      <div class="cta-buttons">
        <a href="/#contact" class="btn btn-primary">Get in touch</a>
        <a href="/#work"    class="btn btn-outline">View work</a>
      </div>
    </div>
  </section>

  <!-- ── Footer ───────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://angel.co/krisburger"        target="_blank" rel="noopener">AngelList</a>
        <a href="mailto:kris@krisburger.com">Email</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ── Page header ──────────────────────────────────── */
  .page-header {
    padding: 120px 0 64px;
  }
  .page-eyebrow { margin-bottom: 16px; }
  .page-headline {
    font-size: clamp(40px, 6vw, 72px);
    color: var(--color-text);
    margin-bottom: 24px;
  }
  .page-subhead {
    font-size: 18px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 560px;
  }
  .hide-mobile { display: none; }
  @media (min-width: 768px) { .hide-mobile { display: inline; } }

  /* ── Stats bar ────────────────────────────────────── */
  .stats-bar {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .stats-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 48px 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex: 1;
    text-align: center;
  }
  .stat-value {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1;
  }
  .stat-label {
    font-size: 13px;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }
  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--color-border);
    flex-shrink: 0;
  }
  @media (max-width: 480px) {
    .stats-inner { padding: 32px 0; }
    .stat-divider { height: 32px; }
  }

  /* ── Sections ─────────────────────────────────────── */
  .section { padding: 96px 0; }
  .section--surface { background: var(--color-surface); }

  /* ── Clients grid ─────────────────────────────────── */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 768px) {
    .clients-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .client-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.2s ease;
    cursor: default;
  }
  .client-cell:hover {
    border-color: var(--color-text-muted);
  }
  .client-logo-wrap {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .client-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .client-cell:hover .client-logo {
    filter: grayscale(0);
    opacity: 1;
  }
  /* Letter fallback when no logo */
  .client-logo-text {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-text-muted);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .client-cell:hover .client-logo-text {
    color: var(--color-text);
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .client-name {
    font-size: 13px;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.4;
  }

  /* ── Industries grid ──────────────────────────────── */
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (max-width: 640px) {
    .industries-grid { grid-template-columns: 1fr; }
  }

  .industry-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .industry-body { flex: 1; }
  .industry-name {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .industry-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .industry-logos {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }
  .industry-logo-item {
    height: 32px;
    display: flex;
    align-items: center;
  }
  .industry-logo-img {
    height: 32px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.5;
  }
  .industry-logo-fallback {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── CTA ──────────────────────────────────────────── */
  .cta-section {
    padding: 96px 0;
    text-align: center;
  }
  .cta-inner { max-width: 560px; margin: 0 auto; }
  .cta-headline {
    font-size: clamp(28px, 4vw, 44px);
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .cta-subhead {
    font-size: 17px;
    color: var(--color-text-muted);
    margin: 0 0 40px;
  }
  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Footer ───────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy {
    font-size: 14px;
    color: var(--color-text-muted);
    margin: 0;
  }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
