---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div id="password-gate" class="gate">
  <div class="gate-inner">
    <div class="gate-lock">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <h2 class="gate-heading">NDA Protected</h2>
    <p class="gate-subhead">This case study is under a non-disclosure agreement. Enter the password to view.</p>
    <form id="password-form" class="gate-form" novalidate>
      <input
        id="password-input"
        type="password"
        placeholder="Enter password"
        autocomplete="current-password"
        class="gate-input"
        required
      />
      <button type="submit" class="btn btn-primary">Unlock</button>
    </form>
    <p id="gate-error" class="gate-error" role="alert" aria-live="polite"></p>
  </div>
</div>

<script define:vars={{ slug }}>
  const STORAGE_KEY = `unlocked-${slug}`;
  const gate = document.getElementById('password-gate');
  const form = document.getElementById('password-form');
  const input = document.getElementById('password-input');
  const errorEl = document.getElementById('gate-error');

  // Already unlocked this session?
  if (sessionStorage.getItem(STORAGE_KEY) === 'true') {
    gate?.remove();
    document.getElementById('project-content')?.removeAttribute('hidden');
  }

  async function sha256(str: string): Promise<string> {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const val = (input as HTMLInputElement)?.value?.trim();
    const storedHash = document.body.dataset.projectPassword ?? '';
    const inputHash = await sha256(val);
    if (inputHash === storedHash) {
      sessionStorage.setItem(STORAGE_KEY, 'true');
      gate?.classList.add('gate--unlocking');
      setTimeout(() => {
        gate?.remove();
        document.getElementById('project-content')?.removeAttribute('hidden');
      }, 400);
    } else {
      if (errorEl) errorEl.textContent = 'Incorrect password. Please try again.';
      (input as HTMLInputElement).value = '';
      (input as HTMLInputElement).focus();
    }
  });
</script>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    transition: opacity 0.4s ease;
  }
  .gate--unlocking { opacity: 0; pointer-events: none; }
  .gate-inner {
    max-width: 400px;
    width: 100%;
    text-align: center;
  }
  .gate-lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
    margin: 0 auto 24px;
  }
  .gate-heading {
    font-size: 28px;
    margin-bottom: 12px;
  }
  .gate-subhead {
    color: var(--color-text-muted);
    font-size: 15px;
    margin: 0 0 32px;
  }
  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .gate-input {
    width: 100%;
    padding: 14px 16px;
    font-size: 15px;
    font-family: var(--font-body);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .gate-input:focus {
    border-color: var(--color-accent);
  }
  .gate-error {
    margin-top: 12px;
    font-size: 14px;
    color: #C62828;
    min-height: 20px;
  }
  .btn { justify-content: center; }
</style>
