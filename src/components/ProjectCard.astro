---
import Tooltip from './Tooltip.astro';

interface Props {
  slug: string;
  name: string;
  summary: string;
  services: string[];
  dateRange: string;
  featuredImage?: string;
  images?: string[];
  logo?: string;
  logoDark?: string;
  companyDescription?: string;
  acquired?: boolean;
  showDate?: boolean;
  index?: number;
}

const { name, summary, services, dateRange, featuredImage, images, logo, logoDark, companyDescription, acquired, showDate = true } = Astro.props;

const projectData = JSON.stringify({
  name,
  summary,
  services,
  dateRange,
  featuredImage,
  images: images ?? [],
  logo,
  logoDark,
  acquired,
});
---

<div class="project-row" data-reveal-child data-project-json={projectData}>

  <!-- Logo cell (replaces number) -->
  <div class="project-logo-cell">
    {logo ? (
      <>
        {logoDark
          ? <>
              <img src={logo}     alt={name} class="project-logo logo-light" loading="lazy" />
              <img src={logoDark} alt={name} class="project-logo logo-dark"  loading="lazy" />
            </>
          : <img src={logo} alt={name} class="project-logo" loading="lazy" />
        }
      </>
    ) : (
      <span class="project-logo-fallback">{name.charAt(0)}</span>
    )}
  </div>

  <!-- Name + summary + services -->
  <div class="project-info">
    <div class="project-title-row">
      <span class="project-title">{name}</span>
      {acquired && <span class="acquired-tag">ACQUIRED</span>}
      {companyDescription && <Tooltip text={companyDescription} />}
    </div>
    <div class="desc-wrap">
      <p class="project-desc">{summary}</p>
      <button class="read-more-btn" aria-expanded="false">Read more</button>
    </div>
    {services.length > 0 && (
      <span class="project-tags">{services.join(' · ')}</span>
    )}
  </div>

  <!-- Date range (standalone grid item) -->
  {showDate && <span class="project-year">{dateRange}</span>}

  <!-- Floating hover preview (desktop only, triggered by row hover) -->
  {featuredImage && (
    <div class="project-preview" aria-hidden="true">
      <img src={featuredImage} alt={name} loading="lazy" decoding="async" />
      <div class="preview-expand">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
          <line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
      </div>
    </div>
  )}
</div>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 128px 1fr auto;
    align-items: start;
    gap: 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    cursor: pointer;
  }
  .project-row:first-child { border-top: 1px solid var(--color-border); }

  /* Default: full strength. Dim siblings when list is being hovered. */
  .project-logo-cell,
  .project-info,
  .project-year {
    transition: opacity 0.25s ease;
  }
  :global(.projects-list.is-row-hovered) .project-logo-cell,
  :global(.projects-list.is-row-hovered) .project-info,
  :global(.projects-list.is-row-hovered) .project-year {
    opacity: 0.35;
  }
  .project-row:hover .project-logo-cell,
  .project-row:hover .project-info,
  .project-row:hover .project-year {
    opacity: 1;
  }

  /* Logo cell */
  .project-logo-cell {
    display: flex;
    align-items: flex-start;
    padding-top: 2px;
  }
  .project-logo {
    width: 128px;
    height: 64px;
    object-fit: cover;
    border-radius: 6px;
  }
  .project-logo-fallback {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  /* Light/dark logo switching */
  :global([data-theme="dark"])  .logo-light,
  :global([data-theme="light"]) .logo-dark  { display: none; }
  :global([data-theme="dark"])  .logo-dark,
  :global([data-theme="light"]) .logo-light { display: block; }

  /* Name + summary + services */
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .project-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .acquired-tag {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    background: var(--color-surface, var(--color-bg));
    border: 1px solid var(--color-border);
    padding: 2px 5px;
    border-radius: 3px;
    white-space: nowrap;
    align-self: center;
  }
  .project-title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .project-desc {
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }
  .project-tags {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .project-year {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--color-text-muted);
    white-space: nowrap;
    width: 96px;
    text-align: right;
    padding-top: 2px;
    align-self: start;
  }

  /* Floating preview */
  .project-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 475px;
    aspect-ratio: 16 / 10;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: opacity 0.25s ease;
    will-change: transform, opacity;
    box-shadow: 0 24px 64px rgba(0,0,0,0.35);
  }
  .project-preview.is-visible { opacity: 1; }
  .project-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Expand icon overlay */
  .preview-expand {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    backdrop-filter: blur(4px);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 10px;
      cursor: default;
    }
    .project-logo-cell { display: none; }
    .project-info { grid-column: 1; padding-top: 8px; }
    .project-year {
      grid-column: 1;
      width: auto;
      text-align: left;
      padding-top: 0;
    }
    .project-preview { display: none; }

    /* 3-line clamp with read more */
    .desc-wrap {
      position: relative;
      cursor: pointer;
    }
    .project-desc {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .desc-wrap.is-expanded .project-desc {
      display: block;
      overflow: visible;
      -webkit-line-clamp: unset;
    }
    /* gradient fade behind "Read more" */
    .desc-wrap::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1.65em;
      background: linear-gradient(to right, transparent 50%, var(--color-bg) 85%);
      pointer-events: none;
    }
    .desc-wrap.is-expanded::after { display: none; }
    .read-more-btn {
      display: inline;
      position: absolute;
      bottom: 0;
      right: 0;
      font-size: 12px;
      font-weight: 500;
      color: var(--color-text-muted);
      cursor: pointer;
      background: none;
      border: none;
      padding: 0 0 0 6px;
      text-decoration: underline;
      text-underline-offset: 2px;
      z-index: 1;
    }
    .desc-wrap.is-expanded .read-more-btn { display: none; }
  }
  @media (min-width: 769px) {
    .desc-wrap { cursor: default; }
    .read-more-btn { display: none; }
  }
</style>

<script>
  // Read more toggle (mobile) — click anywhere on desc-wrap to expand
  document.querySelectorAll<HTMLElement>('.desc-wrap').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLElement>('.read-more-btn');
    if (!btn) return;
    wrap.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = wrap.classList.toggle('is-expanded');
      btn.setAttribute('aria-expanded', String(expanded));
    });
  });

  // Stop tooltip clicks from bubbling to row
  document.querySelectorAll<HTMLElement>('.tt').forEach((tt) => {
    tt.addEventListener('click', (e) => e.stopPropagation());
  });

  const isDesktop = () => window.matchMedia('(min-width: 769px)').matches;

  // Dim sibling rows on row hover (desktop)
  document.querySelectorAll<HTMLElement>('.project-row').forEach((row) => {
    const list = row.closest('.projects-list');
    if (!list) return;
    row.addEventListener('mouseenter', () => { if (isDesktop()) list.classList.add('is-row-hovered'); });
    row.addEventListener('mouseleave', () => list.classList.remove('is-row-hovered'));
  });

  // Floating preview on row hover (desktop only)
  document.querySelectorAll<HTMLElement>('.project-row').forEach((row) => {
    const preview = row.querySelector<HTMLElement>('.project-preview');
    if (!preview) return;

    let targetX = 0, targetY = 0;
    let currentX = 0, currentY = 0;
    let raf: number | null = null;
    let active = false;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function tick() {
      if (!active) return;
      currentX = lerp(currentX, targetX, 0.1);
      currentY = lerp(currentY, targetY, 0.1);
      preview.style.transform = `translate(${currentX}px, ${currentY}px)`;
      raf = requestAnimationFrame(tick);
    }

    // Preview is 475px wide, 16:10 → ~297px tall
    const PW = 475, PH = Math.round(475 * 10 / 16);
    const GAP = 16;

    function posFromCursor(mx: number, my: number) {
      return { x: mx - PW / 2, y: my - PH - GAP };
    }

    row.addEventListener('mouseenter', (e) => {
      if (!isDesktop()) return;
      const { x, y } = posFromCursor((e as MouseEvent).clientX, (e as MouseEvent).clientY);
      targetX = x; targetY = y;
      currentX = x; currentY = y;
      preview.style.transform = `translate(${currentX}px, ${currentY}px)`;
      preview.classList.add('is-visible');
      active = true;
      raf = requestAnimationFrame(tick);
    });

    row.addEventListener('mousemove', (e) => {
      if (!active) return;
      const { x, y } = posFromCursor((e as MouseEvent).clientX, (e as MouseEvent).clientY);
      targetX = x; targetY = y;
    });

    row.addEventListener('mouseleave', () => {
      preview.classList.remove('is-visible');
      active = false;
      if (raf) cancelAnimationFrame(raf);
    });
  });

  // Row click → open modal (desktop only)
  document.querySelectorAll<HTMLElement>('.project-row[data-project-json]').forEach((row) => {
    row.addEventListener('click', () => {
      if (!isDesktop()) return;

      // Build list from all sibling rows in the same .projects-list
      const list = row.closest('.projects-list');
      const allRows = list
        ? Array.from(list.querySelectorAll<HTMLElement>('.project-row[data-project-json]'))
        : [row];

      const projectList = allRows.map((r) => {
        try { return JSON.parse(r.dataset.projectJson!); }
        catch { return null; }
      }).filter(Boolean);

      const index = allRows.indexOf(row);

      document.dispatchEvent(new CustomEvent('project:open', {
        detail: { list: projectList, index: Math.max(0, index) },
      }));
    });
  });
</script>
