---
import Tooltip from './Tooltip.astro';

interface Props {
  slug: string;
  name: string;
  summary: string;
  services: string[];
  dateRange: string;
  featuredImage?: string;
  logo?: string;
  logoDark?: string;
  companyDescription?: string;
  index?: number;
}

const { name, summary, services, dateRange, featuredImage, logo, logoDark, companyDescription } = Astro.props;
---

<div class="project-row" data-reveal-child>

  <!-- Logo cell (replaces number) -->
  <div class="project-logo-cell">
    {logo ? (
      <>
        {logoDark
          ? <>
              <img src={logo}     alt={name} class="project-logo logo-light" loading="lazy" />
              <img src={logoDark} alt={name} class="project-logo logo-dark"  loading="lazy" />
            </>
          : <img src={logo} alt={name} class="project-logo" loading="lazy" />
        }
      </>
    ) : (
      <span class="project-logo-fallback">{name.charAt(0)}</span>
    )}
  </div>

  <!-- Name + summary + services -->
  <div class="project-info">
    <div class="project-title-row">
      <span class="project-title">{name}</span>
      {companyDescription && <Tooltip text={companyDescription} />}
    </div>
    <p class="project-desc">{summary}</p>
    {services.length > 0 && (
      <span class="project-tags">{services.join(' · ')}</span>
    )}
  </div>

  <!-- Date range (standalone grid item) -->
  <span class="project-year">{dateRange}</span>

  <!-- Thumbnail -->
  <div class="project-right">
    {featuredImage && (
      <img src={featuredImage} alt="" class="project-thumb-sm" loading="lazy" decoding="async" />
    )}
  </div>

  <!-- Floating hover preview -->
  {featuredImage && (
    <div class="project-preview" aria-hidden="true">
      <img src={featuredImage} alt={name} loading="lazy" decoding="async" />
    </div>
  )}
</div>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 128px 1fr auto auto;
    align-items: start;
    gap: 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }
  .project-row:first-child { border-top: 1px solid var(--color-border); }

  /* Default: full strength. Dim siblings when list is being hovered. */
  .project-logo-cell,
  .project-info,
  .project-year,
  .project-right {
    transition: opacity 0.25s ease;
  }
  :global(.projects-list.is-row-hovered) .project-logo-cell,
  :global(.projects-list.is-row-hovered) .project-info,
  :global(.projects-list.is-row-hovered) .project-year,
  :global(.projects-list.is-row-hovered) .project-right {
    opacity: 0.35;
  }
  .project-row:hover .project-logo-cell,
  .project-row:hover .project-info,
  .project-row:hover .project-year,
  .project-row:hover .project-right {
    opacity: 1;
  }

  /* Logo cell */
  .project-logo-cell {
    display: flex;
    align-items: flex-start;
    padding-top: 2px;
  }
  .project-logo {
    width: 128px;
    height: 64px;
    object-fit: cover;
    border-radius: 6px;
  }
  .project-logo-fallback {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  /* Light/dark logo switching */
  :global([data-theme="dark"])  .logo-light,
  :global([data-theme="light"]) .logo-dark  { display: none; }
  :global([data-theme="dark"])  .logo-dark,
  :global([data-theme="light"]) .logo-light { display: block; }

  /* Name + summary + services */
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .project-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .project-title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .project-desc {
    font-size: 14px;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0;
  }
  .project-tags {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .project-right {
    flex-shrink: 0;
  }
  .project-thumb-sm {
    width: auto;
    height: 120px;
    border-radius: 6px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .project-year {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--color-text-muted);
    white-space: nowrap;
    width: 96px;
    text-align: right;
    padding-top: 2px;
    align-self: start;
  }

  /* Floating preview */
  .project-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 475px;
    aspect-ratio: 16 / 10;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: opacity 0.25s ease;
    will-change: transform, opacity;
    box-shadow: 0 24px 64px rgba(0,0,0,0.35);
  }
  .project-preview.is-visible { opacity: 1; }
  .project-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Mobile */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: 96px 1fr;
      gap: 12px 16px;
    }
    .project-right { grid-column: 1 / -1; grid-row: 1; }
    .project-thumb-sm {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }
    .project-logo-cell { grid-row: 2; grid-column: 1; }
    .project-info { grid-row: 2; grid-column: 2; }
    .project-year {
      grid-row: 3;
      grid-column: 2;
      width: auto;
      text-align: left;
      padding-top: 0;
    }
    .project-preview { display: none; }
  }
</style>

<script>
  // Dim sibling rows on row hover
  document.querySelectorAll<HTMLElement>('.project-row').forEach((row) => {
    const list = row.closest('.projects-list');
    if (!list) return;
    row.addEventListener('mouseenter', () => list.classList.add('is-row-hovered'));
    row.addEventListener('mouseleave', () => list.classList.remove('is-row-hovered'));
  });

  // Floating preview on thumbnail hover only
  document.querySelectorAll<HTMLElement>('.project-row').forEach((row) => {
    const thumb = row.querySelector<HTMLElement>('.project-thumb-sm');
    const preview = row.querySelector<HTMLElement>('.project-preview');
    if (!thumb || !preview) return;

    let targetX = 0, targetY = 0;
    let currentX = 0, currentY = 0;
    let raf: number | null = null;
    let active = false;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function tick() {
      if (!active) return;
      currentX = lerp(currentX, targetX, 0.1);
      currentY = lerp(currentY, targetY, 0.1);
      preview.style.transform = `translate(${currentX}px, ${currentY}px)`;
      raf = requestAnimationFrame(tick);
    }

    thumb.addEventListener('mouseenter', (e) => {
      const mx = (e as MouseEvent).clientX;
      const my = (e as MouseEvent).clientY;
      targetX = mx - 475 - 28; targetY = my - 140;
      currentX = targetX; currentY = targetY;
      preview.style.transform = `translate(${currentX}px, ${currentY}px)`;
      preview.classList.add('is-visible');
      active = true;
      raf = requestAnimationFrame(tick);
    });

    thumb.addEventListener('mousemove', (e) => {
      targetX = (e as MouseEvent).clientX - 475 - 28;
      targetY = (e as MouseEvent).clientY - 140;
    });

    thumb.addEventListener('mouseleave', () => {
      preview.classList.remove('is-visible');
      active = false;
      if (raf) cancelAnimationFrame(raf);
    });
  });
</script>
