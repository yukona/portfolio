---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  year: number;
  thumbnail?: string;
  featured?: boolean;
  index?: number;
}

const {
  slug,
  title,
  description,
  tags,
  year,
  thumbnail,
  featured = false,
  index = 0,
} = Astro.props;

// Gradient fallbacks per index
const gradients = [
  'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
  'linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 50%, #3a3a3a 100%)',
  'linear-gradient(135deg, #0d0d0d 0%, #1a0a0a 50%, #2d1515 100%)',
];
const fallbackBg = gradients[index % gradients.length];
---

<a
  href={`/projects/${slug}`}
  class:list={['project-card', featured ? 'project-card--featured' : '']}
  data-reveal-child
>
  <!-- Thumbnail -->
  <div class="card-thumb" style={thumbnail ? '' : `background: ${fallbackBg}`}>
    {thumbnail && (
      <img src={thumbnail} alt={title} loading="lazy" decoding="async" />
    )}
  </div>

  <!-- Hover overlay with description -->
  <div class="project-card-overlay">
    <p class="overlay-desc">{description}</p>
  </div>

  <!-- Card meta -->
  <div class="card-meta">
    <div class="card-meta-left">
      <h3 class="card-title">{title}</h3>
      <p class="card-tags">{tags.join(' · ')}</p>
    </div>
    <span class="card-year">{year}</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .project-card--featured .card-thumb {
    height: 560px;
  }
  .card-thumb {
    position: relative;
    height: 320px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .project-card:hover .card-thumb img { transform: scale(1.04); }

  .project-card-overlay {
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .overlay-desc {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    margin: 0;
  }

  .card-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0 0;
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 4px;
  }
  .card-tags {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
  }
  .card-year {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--color-text-muted);
    white-space: nowrap;
    margin-top: 3px;
  }

  @media (max-width: 640px) {
    .project-card--featured .card-thumb { height: 320px; }
  }
</style>
