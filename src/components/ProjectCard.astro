---
interface Props {
  slug: string;
  name: string;
  summary: string;
  services: string[];
  dateRange: string;
  featuredImage?: string;
  logo?: string;
  logoDark?: string;
  index?: number;
}

const { name, summary, services, dateRange, featuredImage, logo, logoDark } = Astro.props;
---

<div class="project-row" data-reveal-child>

  <!-- Logo cell (replaces number) -->
  <div class="project-logo-cell">
    {logo ? (
      <>
        {logoDark
          ? <>
              <img src={logo}     alt={name} class="project-logo logo-light" loading="lazy" />
              <img src={logoDark} alt={name} class="project-logo logo-dark"  loading="lazy" />
            </>
          : <img src={logo} alt={name} class="project-logo" loading="lazy" />
        }
      </>
    ) : (
      <span class="project-logo-fallback">{name.charAt(0)}</span>
    )}
  </div>

  <!-- Name + services -->
  <div class="project-info">
    <span class="project-title">{name}</span>
    {services.length > 0 && (
      <span class="project-tags">{services.join(' · ')}</span>
    )}
  </div>

  <!-- Summary -->
  <p class="project-desc">{summary}</p>

  <!-- Thumbnail + date range -->
  <div class="project-right">
    {featuredImage && (
      <img src={featuredImage} alt="" class="project-thumb-sm" loading="lazy" decoding="async" />
    )}
    <span class="project-year">{dateRange}</span>
  </div>

  <!-- Floating hover preview -->
  {featuredImage && (
    <div class="project-preview" aria-hidden="true">
      <img src={featuredImage} alt={name} loading="lazy" decoding="async" />
    </div>
  )}
</div>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 64px 220px 1fr auto;
    align-items: start;
    gap: 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }
  .project-row:first-child { border-top: 1px solid var(--color-border); }

  /* Logo cell */
  .project-logo-cell {
    display: flex;
    align-items: flex-start;
    padding-top: 2px;
  }
  .project-logo {
    height: 32px;
    width: auto;
    max-width: 72px;
    object-fit: contain;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .project-row:hover .project-logo { opacity: 1; }
  .project-logo-fallback {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  /* Light/dark logo switching */
  [data-theme="dark"]  .logo-light,
  [data-theme="light"] .logo-dark  { display: none; }
  [data-theme="dark"]  .logo-dark,
  [data-theme="light"] .logo-light { display: block; }

  /* Name + services */
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .project-title {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .project-tags {
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .project-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .project-right {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-shrink: 0;
    padding-top: 2px;
  }
  .project-thumb-sm {
    width: 56px;
    height: 40px;
    object-fit: cover;
    border-radius: 6px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }
  .project-row:hover .project-thumb-sm { opacity: 1; }

  .project-year {
    font-family: var(--font-heading);
    font-size: 13px;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Floating preview */
  .project-preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 380px;
    aspect-ratio: 16 / 10;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: opacity 0.25s ease;
    will-change: transform, opacity;
    box-shadow: 0 24px 64px rgba(0,0,0,0.35);
  }
  .project-preview.is-visible { opacity: 1; }
  .project-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Mobile */
  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: 48px 1fr;
      grid-template-rows: auto auto;
      gap: 12px 16px;
    }
    .project-info { grid-column: 2; }
    .project-desc { grid-column: 1 / -1; padding-left: 64px; }
    .project-right { grid-column: 1 / -1; padding-left: 64px; }
    .project-preview { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.project-row').forEach((row) => {
    const preview = row.querySelector<HTMLElement>('.project-preview');
    if (!preview) return;

    let targetX = 0, targetY = 0;
    let currentX = 0, currentY = 0;
    let raf: number | null = null;
    let active = false;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function tick() {
      if (!active) return;
      currentX = lerp(currentX, targetX, 0.1);
      currentY = lerp(currentY, targetY, 0.1);
      preview.style.transform = `translate(${currentX}px, ${currentY}px)`;
      raf = requestAnimationFrame(tick);
    }

    row.addEventListener('mouseenter', (e) => {
      const mx = (e as MouseEvent).clientX;
      const my = (e as MouseEvent).clientY;
      targetX = mx + 28; targetY = my - 140;
      currentX = targetX; currentY = targetY;
      preview.style.transform = `translate(${currentX}px, ${currentY}px)`;
      preview.classList.add('is-visible');
      active = true;
      raf = requestAnimationFrame(tick);
    });

    row.addEventListener('mousemove', (e) => {
      targetX = (e as MouseEvent).clientX + 28;
      targetY = (e as MouseEvent).clientY - 140;
    });

    row.addEventListener('mouseleave', () => {
      preview.classList.remove('is-visible');
      active = false;
      if (raf) cancelAnimationFrame(raf);
    });
  });
</script>
