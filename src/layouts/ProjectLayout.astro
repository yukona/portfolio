---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  thumbnail?: string;
  year?: number;
  role?: string;
  tags?: string[];
  tools?: string[];
  liveUrl?: string;
}

const {
  title,
  description,
  thumbnail,
  year,
  role,
  tags = [],
  tools = [],
  liveUrl,
} = Astro.props;
---

<BaseLayout
  title={`${title} — Kris Burger`}
  description={description}
  image={thumbnail}
  hideNav={false}
>
  <article class="project-page">

    <!-- Back navigation -->
    <div class="back-bar">
      <div class="container">
        <a href="/#work" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          All work
        </a>
      </div>
    </div>

    <!-- Hero -->
    <header class="project-hero">
      <div class="project-hero-thumb" style={!thumbnail ? 'background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)' : ''}>
        {thumbnail && (
          <img src={thumbnail} alt={title} loading="eager" decoding="async" />
        )}
        <div class="project-hero-overlay">
          <div class="container">
            <h1 class="project-title">{title}</h1>
          </div>
        </div>
      </div>
    </header>

    <!-- Meta row -->
    <div class="project-meta-bar">
      <div class="container project-meta-inner">
        <div class="meta-group">
          {year && (
            <div class="meta-item">
              <span class="meta-label">Year</span>
              <span class="meta-value">{year}</span>
            </div>
          )}
          {role && (
            <div class="meta-item">
              <span class="meta-label">Role</span>
              <span class="meta-value">{role}</span>
            </div>
          )}
          {tags.length > 0 && (
            <div class="meta-item">
              <span class="meta-label">Discipline</span>
              <span class="meta-value">{tags.join(' · ')}</span>
            </div>
          )}
          {tools.length > 0 && (
            <div class="meta-item">
              <span class="meta-label">Tools</span>
              <span class="meta-value">{tools.join(', ')}</span>
            </div>
          )}
        </div>
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener" class="btn btn-outline meta-live">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            View live
          </a>
        )}
      </div>
    </div>

    <!-- Body content -->
    <div class="project-body">
      <div class="container project-body-inner">
        <slot />
      </div>
    </div>

    <!-- Next project nav -->
    <slot name="next" />

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-inner">
        <p class="footer-copy">© {new Date().getFullYear()} Kris Burger. All Rights Reserved.</p>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="https://linkedin.com/in/krisburger" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://angel.co/krisburger"        target="_blank" rel="noopener">AngelList</a>
          <a href="mailto:kris@krisburger.com">Email</a>
        </nav>
      </div>
    </footer>

  </article>
</BaseLayout>

<style>
  /* ── Back bar ─────────────────────────────────────── */
  .back-bar {
    padding: 80px 0 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .back-link:hover { color: var(--color-text); gap: 12px; }

  /* ── Project hero ─────────────────────────────────── */
  .project-hero { margin-top: 24px; }
  .project-hero-thumb {
    position: relative;
    height: clamp(320px, 50vw, 640px);
    overflow: hidden;
    background: var(--color-surface);
  }
  .project-hero-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding-bottom: 48px;
  }
  .project-title {
    font-size: clamp(32px, 5vw, 56px);
    color: #fff;
  }

  /* ── Meta bar ─────────────────────────────────────── */
  .project-meta-bar {
    border-bottom: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .project-meta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .meta-group {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .meta-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-value {
    font-size: 15px;
    color: var(--color-text);
  }
  .meta-live { padding: 10px 20px; font-size: 14px; }

  /* ── Body ─────────────────────────────────────────── */
  .project-body { padding: 80px 0 120px; }
  .project-body-inner { max-width: 760px; }

  .project-body-inner :global(h2) {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 500;
    color: var(--color-text);
    margin: 64px 0 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .project-body-inner :global(h2:first-child) { margin-top: 0; }
  .project-body-inner :global(p) {
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.8;
    margin: 0 0 20px;
  }
  .project-body-inner :global(ul),
  .project-body-inner :global(ol) {
    padding-left: 24px;
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.8;
    margin: 0 0 20px;
  }
  .project-body-inner :global(img) {
    width: 100%;
    border-radius: var(--radius-md);
    margin: 32px 0;
  }

  /* ── Footer ─────────────────────────────────────── */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 14px; color: var(--color-text-muted); margin: 0; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a {
    font-size: 14px;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }
  .footer-links a:hover { color: var(--color-text); }
</style>
